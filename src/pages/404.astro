---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/constants';

const popularComparisons = [
  { slug: 'iphone-16-pro-vs-samsung-galaxy-s25', title: 'iPhone 16 Pro vs Samsung Galaxy S25' },
  { slug: 'macbook-pro-vs-dell-xps-15', title: 'MacBook Pro vs Dell XPS 15' },
  { slug: 'chatgpt-vs-claude-ai', title: 'ChatGPT vs Claude AI' },
  { slug: 'bitcoin-vs-ethereum', title: 'Bitcoin vs Ethereum' },
  { slug: 'toyota-camry-vs-honda-accord', title: 'Toyota Camry vs Honda Accord' },
  { slug: 'tesla-model-3-vs-bmw-i4', title: 'Tesla Model 3 vs BMW i4' },
];
---

<BaseLayout
  title={`Page Not Found | ${SITE.name}`}
  description="The page you're looking for doesn't exist. Explore our comparisons or go back to the homepage."
  noindex
>
  <section class="section-padding min-h-[70vh] flex items-center">
    <div class="container-custom">
      <div class="max-w-2xl mx-auto text-center">
        <!-- 404 Graphic -->
        <div class="mb-8">
          <div class="inline-flex items-center justify-center w-32 h-32 bg-gradient-to-br from-primary-100 to-accent-100 rounded-full mb-6">
            <span class="text-6xl font-extrabold gradient-text">404</span>
          </div>
        </div>

        <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Page Not Found</h1>
        <p class="text-lg text-surface-600 mb-8 leading-relaxed">
          Oops! The page you're looking for has been moved, deleted, or never existed.
          Don't worry — let's get you back on track.
        </p>

        <!-- Search Suggestion -->
        <div class="card p-6 mb-8">
          <h2 class="font-semibold text-surface-800 mb-4">Looking for a comparison?</h2>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="notfound-search"
              placeholder="Search for a comparison..."
              class="w-full pl-12 pr-24 py-3 border border-surface-200 rounded-xl focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100 transition-all"
            />
            <button
              onclick="handleSearch()"
              class="absolute right-2 top-1/2 -translate-y-1/2 btn-primary py-2 px-4 text-sm"
            >
              Search
            </button>
          </div>
        </div>

        <!-- Quick Links -->
        <div class="flex flex-wrap items-center justify-center gap-4 mb-10">
          <a href="/" class="btn-primary">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Go to Homepage
          </a>
          <a href="/categories" class="btn-secondary">Browse Categories</a>
        </div>

        <!-- Popular Comparisons -->
        <div>
          <h3 class="text-lg font-semibold text-surface-700 mb-4">Popular Comparisons</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {popularComparisons.map((comp) => (
              <a
                href={`/compare/${comp.slug}`}
                class="flex items-center gap-3 p-3 rounded-xl border border-surface-200 hover:border-primary-300 hover:bg-primary-50 transition-all text-left group"
              >
                <svg class="w-4 h-4 text-surface-400 group-hover:text-primary-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
                <span class="text-sm text-surface-600 group-hover:text-primary-700 font-medium transition-colors">{comp.title}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    function handleSearch() {
      const input = document.getElementById('notfound-search') as HTMLInputElement;
      const query = input.value.trim().toLowerCase();
      if (query.includes(' vs ')) {
        const slug = query.replace(/\s+vs\s+/g, '-vs-');
        window.location.href = `/compare/${slug}`;
      } else if (query) {
        window.location.href = `/search?q=${encodeURIComponent(query)}`;
      }
    }

    document.getElementById('notfound-search')?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') handleSearch();
    });
  </script>
</BaseLayout>
