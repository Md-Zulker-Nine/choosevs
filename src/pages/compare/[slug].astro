  'tesla-model-3-vs-bmw-i4': {
    slug: 'tesla-model-3-vs-bmw-i4',
    title: 'Tesla Model 3 vs BMW i4: Best Electric Sedan?',
    category: 'Cars',
    entityA: { name: 'Tesla Model 3 (2025)', tagline: 'The EV that changed everything', image: '⚡', color: 'red', score: 9.0 },
    entityB: { name: 'BMW i4', tagline: 'BMW performance meets electric efficiency', image: '🔋', color: 'blue', score: 8.7 },
    specs: [
      { label: 'Range (EPA)', valueA: '272-358 miles (trims vary)', valueB: '256-307 miles', winner: 'a' },
      { label: '0-60 mph', valueA: '3.1s (Performance)', valueB: '3.4s (M50)', winner: 'a' },
      { label: 'Base Price', valueA: '$38,990', valueB: '$52,200', winner: 'b' },
      { label: 'Charging Speed', valueA: '250 kW (Supercharger)', valueB: '205 kW (CCS)', winner: 'a' },
      { label: 'Charging Network', valueA: 'Tesla Supercharger (largest)', valueB: 'CCS network + Tesla access', winner: 'a' },
      { label: 'Drive', valueA: 'RWD / AWD', valueB: 'RWD / AWD (M50)', winner: 'tie' },
      { label: 'Interior', valueA: 'Minimalist, 15" screen', valueB: 'Traditional luxury, curved display', winner: 'b' },
      { label: 'Cargo Space', valueA: '22.9 cu ft', valueB: '16.6 cu ft', winner: 'a' },
      { label: 'Build Quality', valueA: 'Good, improved recently', valueB: 'Excellent (BMW standard)', winner: 'b' },
    ],
    prosA: ['Longest range in class', 'Fastest charging with Supercharger network', 'Lower starting price', 'Best software/OTA updates', 'Strong resale value', 'Largest EV charging network access'],
    consA: ['Minimalist interior may feel sparse', 'No Apple CarPlay/Android Auto', 'Build quality inconsistencies', 'Polarizing styling'],
    prosB: ['Superior BMW build quality and materials', 'More traditional luxury interior', 'Available M50 performance variant', 'Apple CarPlay & Android Auto standard', 'Better ride comfort', 'iDrive infotainment system'],
    consB: ['Higher starting price', 'Shorter range', 'Slower charging speed', 'Smaller cargo space', 'Limited charging network vs Tesla'],
    verdict: {
      winner: 'a',
      summary: 'The Tesla Model 3 offers superior range, charging infrastructure, and value. The BMW i4 counters with traditional luxury build quality and a more refined driving experience.',
      recommendation: 'Choose Tesla Model 3 for maximum range, best charging network, and value. Choose BMW i4 if you prioritize luxury interior, build quality, and driving refinement.',
    },
    faqs: [
      { question: 'Which has better range in real-world use?', answer: 'The Tesla Model 3 Long Range consistently achieves 320-340 miles in real-world mixed driving. The BMW i4 eDrive40 achieves 250-270 miles under similar conditions.' },
      { question: 'Can the BMW i4 use Tesla Superchargers?', answer: 'Starting in 2025, BMW vehicles with CCS can use Tesla Superchargers with an adapter. Native NACS ports are coming to future BMW models.' },
      { question: 'Which has lower maintenance costs?', answer: 'Both have lower maintenance costs than ICE vehicles. Tesla has fewer moving parts and no oil changes. BMW offers included maintenance for 3 years/36,000 miles.' },
      { question: 'Is the Tesla Performance worth it?', answer: 'The Tesla Model 3 Performance at 0-60 in 3.1s is exhilarating, but the Long Range offers the best balance of range and performance for most buyers.' },
    ],
    related: [
      { slug: 'toyota-camry-vs-honda-accord', title: 'Toyota Camry vs Honda Accord' },
      { slug: 'iphone-16-pro-vs-samsung-galaxy-s25', title: 'iPhone 16 Pro vs Samsung Galaxy S25' },
      { slug: 'bitcoin-vs-ethereum', title: 'Bitcoin vs Ethereum' },
    ],
  },
};

export function getStaticPaths() {
  return Object.keys(comparisons).map((slug) => ({
    params: { slug },
    props: { data: comparisons[slug] },
  }));
}

const { slug } = Astro.params;
const data: ComparisonData = Astro.props.data;

const winnerText = data.verdict.winner === 'a'
  ? data.entityA.name
  : data.verdict.winner === 'b'
    ? data.entityB.name
    : 'It\'s a Tie';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ComparisonPage",
  "name": data.title,
  "description": data.verdict.summary,
  "mainEntity": [
    {
      "@type": "Product",
      "name": data.entityA.name,
      "description": data.entityA.tagline,
    },
    {
      "@type": "Product",
      "name": data.entityB.name,
      "description": data.entityB.tagline,
    },
  ],
  "dateModified": new Date().toISOString(),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
    { "@type": "ListItem", "position": 2, "name": data.category, "item": `${SITE.url}/category/${data.category.toLowerCase().replace(/ & /g, '-')}` },
    { "@type": "ListItem", "position": 3, "name": data.title, "item": `${SITE.url}/compare/${data.slug}` },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": data.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};
---

<BaseLayout title={`${data.title} | ${SITE.name}`} description={data.verdict.summary}>
  <!-- Top Ad Banner -->
  <div class="ad-placeholder h-24 w-full mb-0">
    Ad Banner (728x90)
  </div>

  <!-- Breadcrumb -->
  <nav class="bg-surface-50 border-b border-surface-200">
    <div class="container-custom py-3">
      <ol class="flex items-center gap-2 text-sm text-surface-500">
        <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li><a href={`/category/${data.category.toLowerCase().replace(/ & /g, '-')}`} class="hover:text-primary-600 transition-colors">{data.category}</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li>
        <li class="text-surface-700 font-medium truncate max-w-xs">{data.entityA.name} vs {data.entityB.name}</li>
      </ol>
    </div>
  </nav>

  <article class="container-custom py-8 md:py-12">
    <!-- Header -->
    <header class="text-center mb-12">
      <span class="badge-primary mb-4">{data.category}</span>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight mb-4">
        {data.entityA.name} vs {data.entityB.name}
      </h1>
      <p class="text-lg text-surface-600 max-w-2xl mx-auto">
        {data.title}
      </p>
    </header>

    <!-- Entity Comparison Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- Entity A -->
      <div class="card-premium p-8 text-center border-t-4 border-t-primary-500">
        <div class="text-6xl mb-4">{data.entityA.image}</div>
        <h2 class="text-2xl font-bold mb-2">{data.entityA.name}</h2>
        <p class="text-surface-600 mb-4">{data.entityA.tagline}</p>
        <div class="inline-flex items-center gap-2">
          <div class="flex">
            {[1,2,3,4,5].map(i => (
              <svg class={`w-5 h-5 ${i <= Math.round(data.entityA.score / 2) ? 'text-amber-400' : 'text-surface-200'}`} fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <span class="font-bold text-lg">{data.entityA.score}/10</span>
        </div>
      </div>

      <!-- Entity B -->
      <div class="card-premium p-8 text-center border-t-4 border-t-accent-500">
        <div class="text-6xl mb-4">{data.entityB.image}</div>
        <h2 class="text-2xl font-bold mb-2">{data.entityB.name}</h2>
        <p class="text-surface-600 mb-4">{data.entityB.tagline}</p>
        <div class="inline-flex items-center gap-2">
          <div class="flex">
            {[1,2,3,4,5].map(i => (
              <svg class={`w-5 h-5 ${i <= Math.round(data.entityB.score / 2) ? 'text-amber-400' : 'text-surface-200'}`} fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <span class="font-bold text-lg">{data.entityB.score}/10</span>
        </div>
      </div>
    </div>

    <!-- VS Divider -->
    <div class="flex items-center justify-center my-10">
      <div class="h-px bg-surface-200 flex-1"></div>
      <div class="mx-6 w-16 h-16 bg-gradient-to-br from-primary-500 to-accent-500 rounded-full flex items-center justify-center text-white font-extrabold text-xl shadow-lg">
        VS
      </div>
      <div class="h-px bg-surface-200 flex-1"></div>
    </div>

    <!-- In-Content Ad -->
    <div class="ad-placeholder h-24 w-full my-8">
      In-Content Ad Banner (728x90)
    </div>

    <!-- Specs Comparison Table -->
    <section class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-8">Detailed Comparison</h2>
      <div class="card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-surface-50 border-b border-surface-200">
                <th class="text-left py-4 px-6 font-semibold text-surface-700">Specification</th>
                <th class="text-left py-4 px-6 font-semibold text-primary-700">{data.entityA.name}</th>
                <th class="text-left py-4 px-6 font-semibold text-accent-700">{data.entityB.name}</th>
                <th class="text-center py-4 px-4 font-semibold text-surface-700 w-20">Winner</th>
              </tr>
            </thead>
            <tbody>
              {data.specs.map((spec) => (
                <tr class="border-b border-surface-100 last:border-0 hover:bg-surface-50 transition-colors">
                  <td class="py-4 px-6 font-medium text-surface-700">{spec.label}</td>
                  <td class="py-4 px-6 text-surface-600">{spec.valueA}</td>
                  <td class="py-4 px-6 text-surface-600">{spec.valueB}</td>
                  <td class="py-4 px-4 text-center">
                    {spec.winner === 'a' && (
                      <span class="badge-success">A</span>
                    )}
                    {spec.winner === 'b' && (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-accent-100 text-accent-700">B</span>
                    )}
                    {spec.winner === 'tie' && (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-surface-100 text-surface-600">Tie</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Pros & Cons Section -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- Entity A Pros & Cons -->
      <div>
        <h3 class="text-xl font-bold text-center mb-6 text-primary-700">{data.entityA.name}</h3>
        <div class="card p-6 mb-4">
          <h4 class="font-semibold text-emerald-700 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Pros
          </h4>
          <ul class="space-y-2">
            {data.prosA.map(pro => (
              <li class="flex items-start gap-2 text-surface-600">
                <span class="text-emerald-500 mt-1 shrink-0">+</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="card p-6">
          <h4 class="font-semibold text-red-700 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            Cons
          </h4>
          <ul class="space-y-2">
            {data.consA.map(con => (
              <li class="flex items-start gap-2 text-surface-600">
                <span class="text-red-500 mt-1 shrink-0">-</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Entity B Pros & Cons -->
      <div>
        <h3 class="text-xl font-bold text-center mb-6 text-accent-700">{data.entityB.name}</h3>
        <div class="card p-6 mb-4">
          <h4 class="font-semibold text-emerald-700 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Pros
          </h4>
          <ul class="space-y-2">
            {data.prosB.map(pro => (
              <li class="flex items-start gap-2 text-surface-600">
                <span class="text-emerald-500 mt-1 shrink-0">+</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="card p-6">
          <h4 class="font-semibold text-red-700 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            Cons
          </h4>
          <ul class="space-y-2">
            {data.consB.map(con => (
              <li class="flex items-start gap-2 text-surface-600">
                <span class="text-red-500 mt-1 shrink-0">-</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Verdict Card -->
    <section class="mb-12">
      <div class="card-premium p-8 md:p-10 bg-gradient-to-br from-primary-50 to-accent-50 border-primary-200">
        <div class="text-center mb-6">
          <div class="inline-flex items-center gap-2 bg-primary-600 text-white px-5 py-2 rounded-full text-sm font-bold mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
            Expert Verdict
          </div>
          <h2 class="text-2xl md:text-3xl font-bold mb-2">
            {data.verdict.winner === 'tie' ? 'The Verdict: It Depends on Your Needs' : `Winner: ${winnerText}`}
          </h2>
        </div>

        <div class="max-w-3xl mx-auto">
          <p class="text-surface-700 text-lg leading-relaxed mb-6 text-center">
            {data.verdict.summary}
          </p>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <h3 class="font-bold text-primary-800 mb-2 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Our Recommendation
            </h3>
            <p class="text-surface-600 leading-relaxed">
              {data.verdict.recommendation}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4 max-w-3xl mx-auto">
        {data.faqs.map((faq, index) => (
          <details class="card p-6 group">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-surface-800 hover:text-primary-600 transition-colors list-none">
              <span>{faq.question}</span>
              <svg class="w-5 h-5 text-surface-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-4 text-surface-600 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Bottom Ad -->
    <div class="ad-placeholder h-24 w-full my-8">
      Bottom Ad Banner (728x90)
    </div>

    <!-- Related Comparisons -->
    <section>
      <h2 class="text-2xl font-bold text-center mb-8">Related Comparisons</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {data.related.map((rel) => (
          <a href={`/compare/${rel.slug}`} class="card p-6 group hover:-translate-y-1 transition-all">
            <h3 class="font-bold text-surface-900 group-hover:text-primary-600 transition-colors mb-2">
              {rel.title}
            </h3>
            <div class="flex items-center text-primary-600 text-sm font-medium">
              Read comparison
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>
  </article>

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
