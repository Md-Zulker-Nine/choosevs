---
import { SITE } from '../lib/constants';

interface Props {
  title?: string;
  url?: string;
  entityA?: string;
  entityB?: string;
  width?: number;
  height?: number;
  id?: string;
}

const {
  title = SITE.name,
  url = new URL(Astro.url.pathname, SITE.url).href,
  entityA = 'Option A',
  entityB = 'Option B',
  width = 600,
  height = 420,
  id = 'embed-widget',
} = Astro.props;

const embedUrl = `${url}${url.includes('?') ? '&' : '?'}embed=1`;

const embedCode = `<iframe src="${embedUrl}" width="${width}" height="${height}" style="border:1px solid #e2e8f0;border-radius:16px;max-width:100%;" loading="lazy" title="${title}" allowfullscreen></iframe>
<p style="font-size:12px;color:#64748b;">Comparison by <a href="${url}" target="_blank" rel="noopener">${SITE.name}</a></p>`;

const panelId = `${id}-panel`;
---

<section
  data-embed-root
  data-embed-id={id}
  class="card p-5 sm:p-6"
  aria-labelledby={`${id}-heading`}
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <h2 id={`${id}-heading`} class="font-display text-lg text-surface-900">Embed this comparison</h2>
      <p class="mt-1 text-sm text-surface-500">
        Add this {entityA} vs {entityB} widget to your own site — free, responsive, and always up to date.
      </p>
    </div>

    <button
      type="button"
      data-embed-toggle
      aria-expanded="false"
      aria-controls={panelId}
      class="btn-primary text-sm py-2 px-4 gap-2 shrink-0"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
      </svg>
      <span data-embed-toggle-text>Embed this comparison</span>
    </button>
  </div>

  <div id={panelId} data-embed-panel class="hidden mt-6 grid gap-6 lg:grid-cols-2">
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-surface-400 mb-2">Preview</h3>
      <div class="rounded-2xl border border-surface-200 bg-gradient-to-br from-white to-surface-50 p-4 shadow-sm">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-primary-500 to-accent-500 flex items-center justify-center">
            <span class="text-white font-bold text-[10px]">VS</span>
          </div>
          <span class="font-display font-bold text-sm text-surface-900">{SITE.name}</span>
        </div>

        <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3">
          <div class="rounded-xl bg-white border border-surface-200 p-3 text-center">
            <p class="text-sm font-semibold text-surface-800 line-clamp-2">{entityA}</p>
          </div>
          <span class="text-xs font-bold text-surface-400">VS</span>
          <div class="rounded-xl bg-white border border-surface-200 p-3 text-center">
            <p class="text-sm font-semibold text-surface-800 line-clamp-2">{entityB}</p>
          </div>
        </div>

        <div class="mt-4 space-y-2" aria-hidden="true">
          <div class="h-2 rounded-full bg-surface-200"></div>
          <div class="h-2 rounded-full bg-surface-200 w-5/6"></div>
          <div class="h-2 rounded-full bg-surface-200 w-2/3"></div>
        </div>

        <a
          href={url}
          class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-primary-600 hover:text-primary-700 transition-colors"
        >
          Read full comparison
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      <p class="mt-2 text-xs text-surface-400">Renders at {width}×{height}px, scales down on mobile.</p>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-surface-400 mb-2">Embed code</h3>
      <label for={`${id}-code`} class="sr-only">Embed code</label>
      <textarea
        id={`${id}-code`}
        data-embed-code
        readonly
        rows="6"
        class="w-full px-3 py-3 text-xs font-mono leading-relaxed rounded-xl border border-surface-200 bg-surface-50 text-surface-700 resize-none outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
      >{embedCode}</textarea>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button type="button" data-embed-copy class="btn-primary text-sm py-2 px-4 gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span data-embed-copy-text>Copy embed code</span>
        </button>
        <p data-embed-status role="status" aria-live="polite" class="text-xs font-medium text-emerald-600 opacity-0 transition-opacity duration-200">
          Embed code copied
        </p>
      </div>

      <p class="mt-3 text-xs text-surface-400">
        By embedding you agree to keep the {SITE.name} attribution link intact.
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-embed-root]').forEach((root) => {
    const toggle = root.querySelector('[data-embed-toggle]');
    const toggleText = root.querySelector('[data-embed-toggle-text]');
    const panel = root.querySelector('[data-embed-panel]');
    const code = root.querySelector('[data-embed-code]');
    const copyBtn = root.querySelector('[data-embed-copy]');
    const copyText = root.querySelector('[data-embed-copy-text]');
    const status = root.querySelector('[data-embed-status]');

    let timer;

    toggle?.addEventListener('click', () => {
      const open = panel?.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      if (toggleText) toggleText.textContent = open ? 'Hide embed code' : 'Embed this comparison';
      if (open) code?.focus();
    });

    copyBtn?.addEventListener('click', async () => {
      const value = code instanceof HTMLTextAreaElement ? code.value : '';

      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value);
        } else if (code instanceof HTMLTextAreaElement) {
          code.select();
          document.execCommand('copy');
        }
        if (copyText) copyText.textContent = 'Copied';
        status?.classList.replace('opacity-0', 'opacity-100');
      } catch {
        if (status) {
          status.textContent = 'Copy failed — select the code manually';
          status.classList.remove('text-emerald-600');
          status.classList.add('text-amber-600');
          status.classList.replace('opacity-0', 'opacity-100');
        }
      }

      clearTimeout(timer);
      timer = setTimeout(() => {
        if (copyText) copyText.textContent = 'Copy embed code';
        status?.classList.replace('opacity-100', 'opacity-0');
      }, 2000);
    });
  });
</script>
