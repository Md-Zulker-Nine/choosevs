---
const {
  title = 'Trending Now',
  subtitle = 'The comparisons everyone is reading this week',
  limit = 8,
} = Astro.props;

const TRENDING = [
  { slug: 'iphone-16-pro-vs-samsung-galaxy-s25', title: 'iPhone 16 Pro vs Samsung Galaxy S25', category: 'Tech', icon: '📱', views: '128.4K', delta: '+42%' },
  { slug: 'chatgpt-vs-claude-ai', title: 'ChatGPT vs Claude AI', category: 'AI Models', icon: '🤖', views: '96.2K', delta: '+68%' },
  { slug: 'bitcoin-vs-ethereum', title: 'Bitcoin vs Ethereum', category: 'Crypto', icon: '₿', views: '81.7K', delta: '+19%' },
  { slug: 'tesla-model-3-vs-bmw-i4', title: 'Tesla Model 3 vs BMW i4', category: 'Cars', icon: '⚡', views: '74.1K', delta: '+27%' },
  { slug: 'netflix-vs-disney-plus', title: 'Netflix vs Disney+', category: 'Movies', icon: '🎬', views: '69.5K', delta: '+11%' },
  { slug: 'macbook-pro-vs-dell-xps-15', title: 'MacBook Pro vs Dell XPS 15', category: 'Tech', icon: '💻', views: '58.3K', delta: '+23%' },
  { slug: 'japan-vs-thailand-travel', title: 'Japan vs Thailand', category: 'Travel', icon: '🗾', views: '51.9K', delta: '+35%' },
  { slug: 'toyota-camry-vs-honda-accord', title: 'Toyota Camry vs Honda Accord', category: 'Cars', icon: '🚗', views: '44.6K', delta: '+8%' },
];

const items = TRENDING.slice(0, limit);
---

<section class="trending" data-trending>
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-8">
    <div>
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-orange-700 text-xs font-bold uppercase tracking-wider mb-3">
        <svg class="w-4 h-4 fire-icon" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd" />
        </svg>
        {title}
      </span>
      <p class="text-surface-600">{subtitle}</p>
    </div>

    <div class="flex items-center gap-2 text-sm text-surface-500">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span data-live-count>2,847</span> people comparing right now
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {items.map((item, i) => (
      <a
        href={`/compare/${item.slug}`}
        class="trend-card card p-5 group relative overflow-hidden hover:-translate-y-1 hover:border-primary-300 transition-all duration-300"
        style={`animation-delay: ${i * 60}ms`}
      >
        <span class="absolute top-3 right-3 text-[10px] font-extrabold text-surface-200 group-hover:text-primary-200 transition-colors">
          #{i + 1}
        </span>

        <div class="text-3xl mb-3">{item.icon}</div>

        <h3 class="font-bold text-surface-900 leading-snug mb-3 group-hover:text-primary-600 transition-colors">
          {item.title}
        </h3>

        <div class="flex items-center justify-between text-xs">
          <span class="badge-primary">{item.category}</span>
          <span class="inline-flex items-center gap-1 font-semibold text-emerald-600">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            {item.delta}
          </span>
        </div>

        <div class="flex items-center gap-1.5 mt-3 text-xs text-surface-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          {item.views} views
        </div>

        <span class="absolute inset-x-0 bottom-0 h-1 bg-gradient-to-r from-primary-500 to-accent-500 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300"></span>
      </a>
    ))}
  </div>
</section>

<style>
  .trend-card {
    opacity: 0;
    animation: trendIn 0.5s ease-out forwards;
  }

  @keyframes trendIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .fire-icon {
    animation: flicker 1.8s ease-in-out infinite;
    transform-origin: bottom center;
  }

  @keyframes flicker {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
    50% { transform: scale(1.15) rotate(-4deg); opacity: 0.85; }
  }

  @media (prefers-reduced-motion: reduce) {
    .trend-card { opacity: 1; animation: none; }
    .fire-icon { animation: none; }
  }
</style>

<script>
  const liveEl = document.querySelector('[data-live-count]');
  if (liveEl) {
    let current = 2847;
    setInterval(() => {
      current += Math.floor(Math.random() * 21) - 8;
      if (current < 2500) current = 2500;
      if (current > 3400) current = 3400;
      liveEl.textContent = current.toLocaleString('en-US');
    }, 3200);
  }
</script>
